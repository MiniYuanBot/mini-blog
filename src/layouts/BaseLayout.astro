---
import { site } from "../../site.config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/motion.css";
import "../styles/disclosure.css";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  article?: boolean;
  showSidebar?: boolean;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description = site.description,
  noindex = false,
  article = false,
  showSidebar,
  structuredData,
} = Astro.props;
const hasSidebar = showSidebar ?? Astro.slots.has("sidebar");
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site || site.url).href;
const jsonLd = structuredData || {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.title,
  url: site.url,
  inLanguage: "en",
  author: { "@type": "Person", name: site.name },
};
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const value = localStorage.getItem("miniyuan-theme");
        if (value === "light" || value === "dark")
          document.documentElement.dataset.theme = value;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — RSS`}
      href="/rss.xml"
    />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" class="shell page-main" tabindex="-1">
      <div
        class:list={[
          "page-layout",
          {
            "page-layout--reading": article,
            "page-layout--sidebar": hasSidebar,
          },
        ]}
      >
        {Astro.slots.has("header") && (
          <div class="page-header">
            <slot name="header" />
          </div>
        )}
        {hasSidebar && (
          <div class="page-sidebar">
            <slot name="sidebar" />
          </div>
        )}
        <div class="page-content">
          <slot name="content">
            <slot />
          </slot>
        </div>
        {Astro.slots.has("after") && (
          <div class="page-after">
            <slot name="after" />
          </div>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
