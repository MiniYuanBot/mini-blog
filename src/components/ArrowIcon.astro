---
import "../styles/arrow.css";
import { arrowGeometry, arrowRotation } from "../lib/arrow.mjs";

export type ArrowDirection = keyof typeof arrowRotation;
interface Props {
  direction?: ArrowDirection;
  class?: string;
}
const { direction = "right", class: className } = Astro.props;
---

<svg
  class:list={["arrow-icon", className]}
  data-arrow-direction={direction}
  xmlns="http://www.w3.org/2000/svg"
  width={arrowGeometry.width}
  height={arrowGeometry.height}
  viewBox={arrowGeometry.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width={arrowGeometry.strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g transform={`rotate(${arrowRotation[direction]} 12 12)`}>
    <line class="arrow-shaft" {...arrowGeometry.shaft} />
    <polyline class="arrow-head" points={arrowGeometry.head} />
  </g>
</svg>
