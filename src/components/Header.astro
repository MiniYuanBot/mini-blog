---
import { collectionNames, sections, site } from "../../site.config";
import ThemeToggle from "./ThemeToggle.astro";
import "../styles/header.css";
const path = Astro.url.pathname;
const links = [
  { title: "Home", href: "/" },
  ...collectionNames.map((name) => ({
    title: sections[name].title,
    href: `/${name}/`,
  })),
];
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      {site.name}
      <span aria-hidden="true">.</span>
    </a>
    <nav class="primary-nav" aria-label="Main navigation">
      {links.map(({ title, href }) => (
        <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
          {title}
        </a>
      ))}
    </nav>
    <div class="header-tools">
      <a
        class="search-link"
        href="/search/"
        aria-label="Search the site"
        aria-current={path.startsWith("/search") ? "page" : undefined}
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="10.5"
            cy="10.5"
            r="6.5"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
      <ThemeToggle />
    </div>
    <details
      class="mobile-menu"
      data-mobile-menu
      data-disclosure="overlay"
      data-disclosure-direction="down"
    >
      <summary
        class="menu-toggle"
        data-menu-toggle
        aria-label="Navigation menu"
        aria-controls="mobile-primary-navigation"
      >
        <span class="menu-icons" aria-hidden="true">
          <svg
            class="menu-icon-open"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 6h16M4 12h16M4 18h16"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
          <svg
            class="menu-icon-close"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m6 6 12 12M18 6 6 18"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
        </span>
        <span>Menu</span>
      </summary>
      <nav
        class="mobile-nav"
        id="mobile-primary-navigation"
        aria-label="Main navigation"
        data-disclosure-panel
      >
        {links.map(({ title, href }) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {title}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
<script>
  import "../scripts/navigation";
</script>
