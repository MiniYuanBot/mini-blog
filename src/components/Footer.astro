---
import { site } from "../../site.config";
---

<footer class="site-footer shell">
  <div class="footer-meta">
    <p>
      © {new Date().getUTCFullYear()} {site.name}
    </p>
    <p class="footer-note">Make love, not prompts.</p>
    <nav aria-label="Footer navigation">
      <a href="/tags/" aria-label="Tags" title="Tags">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20.6 13.4 12 22 2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8Z" />
          <circle cx="7" cy="7" r="1" />
        </svg>
      </a>
      <a href="/rss.xml" aria-label="RSS" title="RSS">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M4 4a16 16 0 0 1 16 16M4 11a9 9 0 0 1 9 9" />
          <circle cx="5" cy="19" r="1" fill="currentColor" />
        </svg>
      </a>
      <a href="/sitemap-index.xml" aria-label="Sitemap" title="Sitemap">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="9" y="2" width="6" height="6" rx="1" />
          <rect x="2" y="16" width="6" height="6" rx="1" />
          <rect x="16" y="16" width="6" height="6" rx="1" />
          <path d="M12 8v4M5 16v-4h14v4" />
        </svg>
      </a>
      <a href={site.contact.github} rel="me" aria-label="GitHub" title="GitHub">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.652.242 2.873.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.595 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
      </a>
      <span class="footer-phone">
        <button
          type="button"
          data-copy-phone={site.contact.phone}
          hidden
          aria-label={`Copy phone number: ${site.contact.phoneLabel}`}
          title={`Copy phone number: ${site.contact.phoneLabel}`}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.1 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7 12.8 12.8 0 0 0 .7 2.8 2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5 12.8 12.8 0 0 0 2.8.7 2 2 0 0 1 1.8 2.1Z" />
          </svg>
        </button>
        <span
          class="footer-copy-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></span>
      </span>
      <a
        href={`mailto:${site.contact.email}`}
        aria-label={`Email: ${site.contact.email}`}
        title={`Email: ${site.contact.email}`}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m2 6 10 7L22 6" />
        </svg>
      </a>
    </nav>
  </div>
</footer>

<script>
  import { copyText } from "../scripts/clipboard";

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-phone]",
  )) {
    const phone = button.dataset.copyPhone;
    const status = button.parentElement?.querySelector<HTMLElement>(
      ".footer-copy-status",
    );
    if (!phone || !status) continue;
    button.hidden = false;
    const label = button.getAttribute("aria-label") || "Copy phone number";
    const title = button.title;
    let timer = 0;
    let copying = false;

    button.addEventListener("click", async () => {
      if (copying) return;
      copying = true;
      window.clearTimeout(timer);
      status.textContent = "";
      button.setAttribute("aria-busy", "true");
      try {
        await copyText(phone);
        button.setAttribute("aria-label", "Phone number copied");
        button.title = "Phone number copied";
        status.textContent = "Phone number copied";
      } catch {
        button.setAttribute(
          "aria-label",
          `Copy failed. Phone number: ${phone}`,
        );
        button.title = `Copy failed. Phone number: ${phone}`;
        status.textContent = "Copy failed";
      } finally {
        copying = false;
        button.removeAttribute("aria-busy");
        timer = window.setTimeout(() => {
          button.setAttribute("aria-label", label);
          button.title = title;
          status.textContent = "";
        }, 2500);
      }
    });
  }
</script>
