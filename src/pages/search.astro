---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";
import ActionLink from "../components/ActionLink.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import { collectionNames, sections } from "../../site.config";
import { getEntries } from "../lib/content";
const total = (await getEntries()).length;
---

<BaseLayout
  title="Search"
  description="Search the complete text of research, projects, explorations, and study notes."
  noindex
>
  <PageHeading
    slot="header"
    title="Search"
    description="Find a passage, follow an idea, or pick up where you left off."
    eyebrow="Across the archive"
  />
  <Fragment slot="content">
    <form
      class="search-form"
      id="search-form"
      role="search"
      action="/search/"
      method="get"
      data-total={total}
    >
      <label for="search-input">Search the full text</label>
      <div class="search-input-row">
        <input
          class="search-input"
          id="search-input"
          name="q"
          type="search"
          placeholder="A word, a topic, a line of code…"
          autocomplete="off"
          enterkeyhint="search"
          aria-describedby="search-status"
        />
        <button type="submit">
          Search <ArrowIcon direction="right" />
        </button>
      </div>
      <div class="search-controls">
        <label for="search-collection">Look in</label>
        <select id="search-collection" name="section">
          <option value="">Everything</option>
          {collectionNames.map((name) => (
            <option value={name}>{sections[name].title}</option>
          ))}
        </select>
        <span class="search-shortcut">
          Press <kbd>/</kbd> to focus
        </span>
      </div>
    </form>
    <p
      class="search-status"
      id="search-status"
      role="status"
      aria-live="polite"
    >
      {total
        ? "Enter a word or phrase to begin."
        : "There is nothing to search yet. Published entries will appear here."}
    </p>
    <ol class="search-results" id="search-results"></ol>
    <button class="load-more" id="search-more" type="button" hidden>
      Show more results
    </button>
    <div class="search-empty" id="search-empty">
      <p>Prefer to browse?</p>
      <ActionLink href="/explorations/" direction="up-right">
        Explorations
      </ActionLink>
      <ActionLink href="/studies/" direction="up-right">
        Studies
      </ActionLink>
      <ActionLink href="/tags/" direction="up-right">
        All tags
      </ActionLink>
    </div>
    <noscript>
      <p>
        Search needs JavaScript. You can still browse{" "}
        <a href="/explorations/">explorations</a>,{" "}
        <a href="/studies/">study notes</a>, and <a href="/tags/">tags</a>.
      </p>
    </noscript>
  </Fragment>
</BaseLayout>
<script>
  import "../scripts/search";
</script>
